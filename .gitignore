# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android release signing material must stay in local/CI secret stores.
/android/key.properties
/android/app/*.jks
/android/app/*.keystore
# Local exported upload certificate is an operator backup/Play setup artifact.
# It is public-key material, but it still does not belong in the app source tree.
/upload_certificate.pem

# Local Firebase input/output. The Android client JSON contains public client
# identifiers, but the publisher config stays outside source to avoid project
# mix-ups. Service-account JSON is always a server secret.
/google-services.json
/android/app/google-services.json
/config/firebase-production.env.local
/firebase-service-account*.json
