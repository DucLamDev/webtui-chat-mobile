# Official Android Firebase client for com.vpsttt.webtui_chat.
# The first, third and fourth values are fixed in the protected CI workflow.
# Download google-services.json from Firebase Console and copy only
# client[].api_key[].current_key into MOBILE_FIREBASE_API_KEY.
MOBILE_FIREBASE_API_KEY=REPLACE_FROM_GOOGLE_SERVICES_JSON_CURRENT_KEY
MOBILE_FIREBASE_MESSAGING_SENDER_ID=595077870179
MOBILE_FIREBASE_PROJECT_ID=webtui-chat
MOBILE_FIREBASE_ANDROID_APP_ID=1:595077870179:android:a6f4ff5cc14a0d1485be56
# Google Play-only release: keep this empty until an iOS Firebase app exists.
MOBILE_FIREBASE_IOS_APP_ID=
